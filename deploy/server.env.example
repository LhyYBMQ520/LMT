LMT_ADDR=127.0.0.1:18080,[::1]:18080
# For IPv4-only loopback, use LMT_ADDR=127.0.0.1:18080 instead.
LMT_PUBLIC_URL=https://listen.example.com
LMT_BEHIND_PROXY=1
LMT_WEB_DIR=/opt/LMT-linux-amd64/web
LMT_ROOM_TTL=4h
LMT_CREATE_KEY=replace-with-a-long-random-creation-key
# Public STUN helps direct connections; it does not relay audio. Availability depends on each peer's network.
LMT_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]
# Optional TURN fallback: replace the domain and credentials before enabling.
# LMT_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.example.com:3478?transport=udp","turn:turn.example.com:3478?transport=tcp"],"username":"replace-me","credential":"replace-me"}]
# To terminate TLS in Go instead of a reverse proxy, unset LMT_BEHIND_PROXY and set both:
# LMT_TLS_CERT=/etc/letsencrypt/live/listen.example.com/fullchain.pem
# LMT_TLS_KEY=/etc/letsencrypt/live/listen.example.com/privkey.pem
